generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model File {
  id               Int      @id @default(autoincrement())
  size             Int
  newFilename      String   @unique
  originalFilename String
  mimetype         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
